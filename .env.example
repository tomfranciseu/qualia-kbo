# A local, persisted embedded database. Keep this outside OneDrive in normal use.
# KBO_DATABASE_PATH=C:\Users\<you>\AppData\Local\qualia-kbo\kbo.duckdb

# Optional shared PostgreSQL backend. Start it with `docker compose up -d`.
# KBO_STORAGE=postgres
# KBO_DATABASE_URL=postgresql://kbo:kbo@localhost:5436/kbo

# NBB CBSO Authentic Data Query (annual accounts JSON)
NBB_CBSO_SUBSCRIPTION_KEY=
# NBB_CBSO_BASE_URL=https://ws.cbso.nbb.be
