{
  "name": "@qualia/kbo",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Belgian KBO registry — standalone DB, ETL, and lookup",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/index.ts",
    "src/client.ts",
    "src/lookup.ts",
    "src/activity.ts",
    "src/types.ts",
    "src/vat.ts",
    "src/nbb",
    "src/generated",
    "prisma"
  ],
  "scripts": {
    "db:init": "tsx -e \"import('./src/client.ts').then(async ({ createKboClient, disconnectKboClient }) => { await createKboClient(); await disconnectKboClient(); console.log('DuckDB database initialized.'); })\"",
    "migrate:dev": "npm run db:init",
    "migrate:deploy": "npm run db:init",
    "migrate:status": "npm run db:init",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "load:all": "tsx src/load/run-all.ts",
    "load:delete": "tsx src/load/run-file.ts delete",
    "load:code": "tsx src/load/run-file.ts code",
    "load:codes": "npm run load:code",
    "load:enterprise": "tsx src/load/run-file.ts enterprise",
    "load:establishment": "tsx src/load/run-file.ts establishment",
    "load:address": "tsx src/load/run-file.ts address",
    "load:contact": "tsx src/load/run-file.ts contact",
    "load:contacts": "npm run load:contact",
    "load:denomination": "tsx src/load/run-file.ts denomination",
    "load:branch": "tsx src/load/run-file.ts branch",
    "load:activity": "tsx src/load/run-file.ts activity",
    "load:meta": "tsx src/load/run-file.ts meta",
    "load:audit": "tsx src/load/audit.ts",
    "report:nace-postcodes": "tsx src/report-nace-postal-codes.ts",
    "report:nace-nbb": "tsx src/report-nace-nbb.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.3",
    "@duckdb/node-api": "^1.5.0-r.1",
    "dotenv": "^17.4.2",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
